{
  "name": "emppay-desktop",
  "version": "1.0.0",
  "description": "Standalone employee payroll desktop software",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pandp.enterprises",
    "productName": "P & P Enterprises",
    "files": ["main.cjs", "preload.cjs", "index.html", "app.js", "styles.css", "logo.jpg", "package.json", "node_modules/**/*"],
    "win": { "target": "nsis", "icon": "" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
